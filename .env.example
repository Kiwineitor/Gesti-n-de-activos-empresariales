# Copia este archivo como .env para personalizar (opcional: sin .env se usan estos valores)

# Puerto de la aplicación en tu máquina → http://localhost:9006
APP_PORT=9006

# Base de datos (PostgreSQL dentro de Docker)
DB_NAME=servicedesk
DB_USER=servicedesk
DB_PASSWORD=servicedesk
# Puerto para conectarte a la BD desde tu máquina (DBeaver/pgAdmin)
DB_PORT=5433

# Clave para firmar los tokens JWT (mínimo 32 caracteres; cámbiala fuera de desarrollo)
JWT_SECRET=cambia-esta-clave-secreta-de-al-menos-32-caracteres

# true → al arrancar con la BD vacía carga usuarios y solicitudes de prueba
DEMO_DATA=true
