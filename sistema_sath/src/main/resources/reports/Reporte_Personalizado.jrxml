<!-- Created with Jaspersoft Studio version 7.0.3.final using JasperReports Library version 7.0.3-41034ca841d452f3305ba55b9042260aaa1ab5dd  -->
<jasperReport name="Reporte_Personalizado" language="java" pageWidth="792" pageHeight="612" orientation="Landscape" columnWidth="752" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20" uuid="e7b1a2c3-d4e5-4f60-8071-9a2b3c4d5e6f">
	<parameter name="fecha_inicial" class="java.util.Date"/>
	<parameter name="fecha_final" class="java.util.Date"/>
	<parameter name="id_unidad" class="java.lang.Long"/>
	<parameter name="id_tipo_servicio" class="java.lang.Long"/>
	<parameter name="id_tipo_activo" class="java.lang.Long"/>
	<parameter name="id_administrativo" class="java.lang.Long"/>
	<parameter name="logoPrincipal" class="java.io.InputStream"/>
	<parameter name="logoSecundario" class="java.io.InputStream"/>
	<query language="sql"><![CDATA[SELECT DISTINCT ON (so.nro_sol, ds.id_detalle_solicitud)
    COALESCE(p_adm.nombre_per || ' ' || p_adm.ap_paterno_per || ' ' || COALESCE(p_adm.ap_materno_per, ''), 'Sistema ServiceDesk') AS nom_completo_admin,
    COALESCE(c_adm.nombre_car, '—')                                                       AS cargo_admin,
    COALESCE(u_adm.nombre_uni, '—')                                                       AS unidad_admin,
    so.nro_sol                                                                             AS numero_servicio,
    p_sol.nombre_per || ' ' || p_sol.ap_paterno_per || ' ' || COALESCE(p_sol.ap_materno_per, '') AS nombre_solicitante,
    COALESCE(u_sol.nombre_uni, '—')                                                        AS unidad_sol,
    COALESCE(c_sol.nombre_car, '—')                                                        AS cargo_sol,
    COALESCE(a.codigo_act, '—')                                                            AS cod_equipo,
    COALESCE(tip.nombre_tipo_act, '—')                                                     AS equipo,
    COALESCE(a.descripcion_act, '—')                                                       AS descripcion,
    COALESCE(ts.nombre_tipo, srv.nombre_serv, '—')                                         AS nom_tipo_servicio,
    so.fecha_sol                                                                            AS fecha_recepcion,
    aten.fecha_fin_reparacion_aten_sol                                                      AS fecha_entrega
FROM solicitud so
LEFT JOIN administrativo adm_sol  ON so.id_administrativo = adm_sol.id_administrativo
LEFT JOIN persona p_sol           ON adm_sol.id_persona = p_sol.id_persona
LEFT JOIN unidad u_sol            ON adm_sol.id_unidad = u_sol.id_unidad
LEFT JOIN cargo c_sol             ON adm_sol.id_cargo = c_sol.id_cargo
LEFT JOIN detalle_solicitud ds    ON so.id_solicitud = ds.id_solicitud
                                 AND ds._estado_aud <> 'ELIMINADO'
LEFT JOIN activo a                ON ds.id_activo = a.id_activo
LEFT JOIN tipo_activo tip         ON a.id_tipo_activo = tip.id_tipo_activo
LEFT JOIN atencion_solicitud aten ON ds.id_detalle_solicitud = aten.id_detalle_solicitud
                                 AND aten._estado_aud <> 'ELIMINADO'
LEFT JOIN atencion_servicio aserv ON aten.id_atencion_solicitud = aserv.id_atencion_solicitud
                                 AND aserv._estado_aud <> 'ELIMINADO'
LEFT JOIN servicio srv            ON aserv.id_servicio = srv.id_servicio
LEFT JOIN tipo_servicio ts        ON srv.id_tipo_servicio = ts.id_tipo_servicio
LEFT JOIN administrativo adm_rep  ON adm_rep.id_administrativo = $P{id_administrativo}
LEFT JOIN persona p_adm           ON adm_rep.id_persona = p_adm.id_persona
LEFT JOIN cargo c_adm             ON adm_rep.id_cargo = c_adm.id_cargo
LEFT JOIN unidad u_adm            ON adm_rep.id_unidad = u_adm.id_unidad
WHERE so.estado_sol = 'FINALIZADO'
  AND so._estado_aud <> 'ELIMINADO'
  AND so.fecha_sol BETWEEN $P{fecha_inicial} AND $P{fecha_final}
  AND ($P{id_unidad} IS NULL OR adm_sol.id_unidad = $P{id_unidad})
  AND ($P{id_tipo_activo} IS NULL OR a.id_tipo_activo = $P{id_tipo_activo})
  AND ($P{id_tipo_servicio} IS NULL OR EXISTS (
      SELECT 1 FROM atencion_solicitud ax
      JOIN atencion_servicio axs ON ax.id_atencion_solicitud = axs.id_atencion_solicitud AND axs._estado_aud <> 'ELIMINADO'
      JOIN servicio sx ON axs.id_servicio = sx.id_servicio
      WHERE ax.id_detalle_solicitud = ds.id_detalle_solicitud
        AND sx.id_tipo_servicio = $P{id_tipo_servicio}
        AND ax._estado_aud <> 'ELIMINADO'
  ))
ORDER BY so.nro_sol, ds.id_detalle_solicitud, aten.id_atencion_solicitud]]></query>
