<jasperReport name="Reporte_General" language="java" pageWidth="792" pageHeight="612" orientation="Landscape" columnWidth="752" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20" uuid="d56cdfdf-82f6-4ba2-afc0-fc8019bd71b8">
	<parameter name="fecha_inicial" class="java.util.Date"/>
	<parameter name="fecha_final" class="java.util.Date"/>
	<parameter name="id_administrativo" class="java.lang.Long"/>
	<parameter name="logoPrincipal" class="java.io.InputStream"/>
	<parameter name="logoSecundario" class="java.io.InputStream"/>
	<query language="sql"><![CDATA[SELECT DISTINCT
    COALESCE(p_adm.nombre_per || ' ' || p_adm.ap_paterno_per || ' ' || p_adm.ap_materno_per, 'Sistema ServiceDesk') AS nom_completo_admin,
    COALESCE(c_adm.nombre_car, '—')  AS cargo_admin,
    COALESCE(u_adm.nombre_uni, '—')  AS unidad_admin,
    so.nro_sol                                                                         AS numero_servicio,
    p_sol.nombre_per || ' ' || p_sol.ap_paterno_per || ' ' || p_sol.ap_materno_per    AS nombre_solicitante,
    u_sol.nombre_uni                                                                   AS unidad_sol,
    c_sol.nombre_car                                                                   AS cargo_sol,
    a.codigo_act                                                                       AS cod_equipo,
    tip.nombre_tipo_act                                                                AS equipo,
    a.descripcion_act                                                                  AS descripcion,
    COALESCE(srv.nombre_serv, 'MANTENIMIENTO CORRECTIVO')                              AS nom_tipo_servicio,
    so.fecha_sol                                                                       AS fecha_recepcion,
    aten.fecha_fin_reparacion_aten_sol                                                 AS fecha_entrega
FROM solicitud so
LEFT JOIN administrativo adm_sol  ON so.id_administrativo = adm_sol.id_administrativo
LEFT JOIN persona p_sol           ON adm_sol.id_persona = p_sol.id_persona
LEFT JOIN unidad u_sol            ON adm_sol.id_unidad = u_sol.id_unidad
LEFT JOIN cargo c_sol             ON adm_sol.id_cargo = c_sol.id_cargo
LEFT JOIN detalle_solicitud ds    ON so.id_solicitud = ds.id_solicitud
LEFT JOIN activo a                ON ds.id_activo = a.id_activo
LEFT JOIN tipo_activo tip         ON a.id_tipo_activo = tip.id_tipo_activo
LEFT JOIN atencion_solicitud aten ON ds.id_detalle_solicitud = aten.id_detalle_solicitud
LEFT JOIN atencion_servicio aserv ON aten.id_atencion_solicitud = aserv.id_atencion_solicitud
LEFT JOIN servicio srv            ON aserv.id_servicio = srv.id_servicio
LEFT JOIN administrativo adm_rep  ON adm_rep.id_administrativo = $P{id_administrativo}
LEFT JOIN persona p_adm           ON adm_rep.id_persona = p_adm.id_persona
LEFT JOIN cargo c_adm             ON adm_rep.id_cargo = c_adm.id_cargo
LEFT JOIN unidad u_adm            ON adm_rep.id_unidad = u_adm.id_unidad
WHERE so.estado_sol = 'FINALIZADO'
  AND so.fecha_sol BETWEEN $P{fecha_inicial} AND $P{fecha_final}
ORDER BY so.fecha_sol]]></query>
	<field name="nom_completo_admin" class="java.lang.String"/>
	<field name="cargo_admin" class="java.lang.String"/>
	<field name="unidad_admin" class="java.lang.String"/>
	<field name="numero_servicio" class="java.lang.Long"/>
	<field name="nombre_solicitante" class="java.lang.String"/>
	<field name="unidad_sol" class="java.lang.String"/>
	<field name="cargo_sol" class="java.lang.String"/>
	<field name="cod_equipo" class="java.lang.String"/>
	<field name="equipo" class="java.lang.String"/>
	<field name="descripcion" class="java.lang.String"/>
	<field name="nom_tipo_servicio" class="java.lang.String"/>
	<field name="fecha_recepcion" class="java.sql.Date"/>
	<field name="fecha_entrega" class="java.sql.Date"/>
	<variable name="FILA" calculation="Count" class="java.lang.Integer">
		<expression><![CDATA[Integer.valueOf(1)]]></expression>
	</variable>
