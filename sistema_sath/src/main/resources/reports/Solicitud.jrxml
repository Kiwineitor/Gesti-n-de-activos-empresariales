<!-- Created with Jaspersoft Studio version 7.0.3.final using JasperReports Library version 7.0.3-41034ca841d452f3305ba55b9042260aaa1ab5dd  -->
<jasperReport name="Solicitud" language="java" pageWidth="612" pageHeight="792" columnWidth="552" leftMargin="30" rightMargin="30" topMargin="20" bottomMargin="20" uuid="b1c2d3e4-0001-4abc-9def-000000000001">
	<parameter name="id_solicitud" class="java.lang.Long"/>
	<parameter name="logoPrincipal" class="java.io.InputStream"/>
	<query language="sql"><![CDATA[
SELECT
    s.nro_sol,
    s.gestion_sol,
    s.fecha_sol,
    s.estado_sol,
    s.descripcion_sol,
    CONCAT(p.nombre_per,' ',p.ap_paterno_per,' ',COALESCE(p.ap_materno_per,'')) AS nombre_completo,
    COALESCE(p.ci_per,'')     AS ci_per,
    COALESCE(u.nombre_uni,'') AS nombre_uni,
    COALESCE(c.nombre_car,'') AS nombre_car,
    COALESCE(STRING_AGG(
        DISTINCT
        COALESCE(a.codigo_act,'—') || ' | ' ||
        COALESCE(a.descripcion_act,'—') || ' [' ||
        COALESCE(ta.nombre_tipo_act,'—') || '] — ' ||
        COALESCE(fr.descripcion_fall_rep,'Sin problema reportado'),
        E'\n'
    ), '—') AS activos_detalle
FROM solicitud s
JOIN administrativo  adm ON adm.id_administrativo = s.id_administrativo
JOIN persona         p   ON p.id_persona           = adm.id_persona
LEFT JOIN unidad     u   ON u.id_unidad             = adm.id_unidad
LEFT JOIN cargo      c   ON c.id_cargo              = adm.id_cargo
LEFT JOIN detalle_solicitud ds ON ds.id_solicitud   = s.id_solicitud
                               AND ds._estado_aud <> 'ELIMINADO'
LEFT JOIN activo     a   ON a.id_activo             = ds.id_activo
LEFT JOIN tipo_activo ta ON ta.id_tipo_activo       = a.id_tipo_activo
LEFT JOIN falla_reportada fr
       ON fr.id_detalle_solicitud = ds.id_detalle_solicitud
      AND fr._estado_aud <> 'ELIMINADO'
WHERE s.id_solicitud = $P{id_solicitud}
GROUP BY
    s.nro_sol, s.gestion_sol, s.fecha_sol, s.estado_sol, s.descripcion_sol,
    p.nombre_per, p.ap_paterno_per, p.ap_materno_per, p.ci_per,
    u.nombre_uni, c.nombre_car
	]]></query>
	<field name="nro_sol"         class="java.lang.Long"/>
	<field name="gestion_sol"     class="java.lang.Integer"/>
	<field name="fecha_sol"       class="java.sql.Date"/>
	<field name="estado_sol"      class="java.lang.String"/>
	<field name="descripcion_sol" class="java.lang.String"/>
	<field name="nombre_completo" class="java.lang.String"/>
	<field name="ci_per"          class="java.lang.String"/>
	<field name="nombre_uni"      class="java.lang.String"/>
	<field name="nombre_car"      class="java.lang.String"/>
	<field name="activos_detalle" class="java.lang.String"/>
