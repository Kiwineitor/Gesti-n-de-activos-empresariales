<!-- Created with Jaspersoft Studio version 7.0.3.final using JasperReports Library version 7.0.3-41034ca841d452f3305ba55b9042260aaa1ab5dd  -->
<jasperReport name="Reporte_Estadistico_Servicios" language="java" pageWidth="612" pageHeight="792" columnWidth="572" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20" uuid="e0000001-0001-0001-0001-000000000001" summaryNewPage="true">
	<dataset name="dsServiceTypes" uuid="e0000002-0001-0001-0001-000000000001">
		<parameter name="fecha_inicial" class="java.util.Date"/>
		<parameter name="fecha_final" class="java.util.Date"/>
		<query language="sql"><![CDATA[SELECT
    COALESCE(ts.nombre_tipo, srv.nombre_serv, 'SIN TIPO') AS nom_tipo_servicio,
    COUNT(DISTINCT ds.id_detalle_solicitud)                AS cantidad
FROM solicitud so
LEFT JOIN detalle_solicitud ds    ON so.id_solicitud = ds.id_solicitud AND ds._estado_aud <> 'ELIMINADO'
LEFT JOIN atencion_solicitud aten ON ds.id_detalle_solicitud = aten.id_detalle_solicitud AND aten._estado_aud <> 'ELIMINADO'
LEFT JOIN atencion_servicio aserv ON aten.id_atencion_solicitud = aserv.id_atencion_solicitud AND aserv._estado_aud <> 'ELIMINADO'
LEFT JOIN servicio srv            ON aserv.id_servicio = srv.id_servicio
LEFT JOIN tipo_servicio ts        ON srv.id_tipo_servicio = ts.id_tipo_servicio
WHERE so.estado_sol = 'FINALIZADO'
  AND so._estado_aud <> 'ELIMINADO'
  AND so.fecha_sol BETWEEN $P{fecha_inicial} AND $P{fecha_final}
GROUP BY COALESCE(ts.nombre_tipo, srv.nombre_serv, 'SIN TIPO')
ORDER BY cantidad DESC]]></query>
		<field name="nom_tipo_servicio" class="java.lang.String"/>
		<field name="cantidad" class="java.lang.Long"/>
	</dataset>
	<parameter name="fecha_inicial" class="java.util.Date"/>
	<parameter name="fecha_final" class="java.util.Date"/>
	<parameter name="id_administrativo" class="java.lang.Long"/>
	<parameter name="logoUap" class="java.io.InputStream"/>
	<parameter name="Dtic" class="java.io.InputStream"/>
	<query language="sql"><![CDATA[SELECT * FROM (
    SELECT DISTINCT ON (so.nro_sol, ds.id_detalle_solicitud)
        COALESCE(p_adm.nombre_per || ' ' || p_adm.ap_paterno_per || ' ' || COALESCE(p_adm.ap_materno_per, ''), 'Sistema SATH') AS nom_completo_admin,
        COALESCE(c_adm.nombre_car, '—')                                                                                          AS cargo_admin,
        COALESCE(u_adm.nombre_uni, '—')                                                                                          AS unidad_admin,
        so.nro_sol                                                                                                               AS numero_servicio,
        p_sol.nombre_per || ' ' || p_sol.ap_paterno_per || ' ' || COALESCE(p_sol.ap_materno_per, '')                            AS nombre_solicitante,
        COALESCE(u_sol.nombre_uni, '—')                                                                                          AS unidad_sol,
        COALESCE(a.codigo_act, '—')                                                                                              AS cod_equipo,
        COALESCE(tip.nombre_tipo_act, '—')                                                                                       AS equipo,
        COALESCE(ts.nombre_tipo, srv.nombre_serv, 'SIN TIPO')                                                                   AS nom_tipo_servicio,
        so.fecha_sol                                                                                                             AS fecha_recepcion,
        aten.fecha_fin_reparacion_aten_sol                                                                                       AS fecha_entrega
    FROM solicitud so
    LEFT JOIN administrativo adm_sol  ON so.id_administrativo = adm_sol.id_administrativo
    LEFT JOIN persona p_sol           ON adm_sol.id_persona = p_sol.id_persona
    LEFT JOIN unidad u_sol            ON adm_sol.id_unidad = u_sol.id_unidad
    LEFT JOIN detalle_solicitud ds    ON so.id_solicitud = ds.id_solicitud AND ds._estado_aud <> 'ELIMINADO'
    LEFT JOIN activo a                ON ds.id_activo = a.id_activo
    LEFT JOIN tipo_activo tip         ON a.id_tipo_activo = tip.id_tipo_activo
    LEFT JOIN atencion_solicitud aten ON ds.id_detalle_solicitud = aten.id_detalle_solicitud AND aten._estado_aud <> 'ELIMINADO'
    LEFT JOIN atencion_servicio aserv ON aten.id_atencion_solicitud = aserv.id_atencion_solicitud AND aserv._estado_aud <> 'ELIMINADO'
    LEFT JOIN servicio srv            ON aserv.id_servicio = srv.id_servicio
    LEFT JOIN tipo_servicio ts        ON srv.id_tipo_servicio = ts.id_tipo_servicio
    LEFT JOIN administrativo adm_rep  ON adm_rep.id_administrativo = $P{id_administrativo}
    LEFT JOIN persona p_adm           ON adm_rep.id_persona = p_adm.id_persona
    LEFT JOIN cargo c_adm             ON adm_rep.id_cargo = c_adm.id_cargo
    LEFT JOIN unidad u_adm            ON adm_rep.id_unidad = u_adm.id_unidad
    WHERE so.estado_sol = 'FINALIZADO'
      AND so._estado_aud <> 'ELIMINADO'
      AND so.fecha_sol BETWEEN $P{fecha_inicial} AND $P{fecha_final}
    ORDER BY so.nro_sol, ds.id_detalle_solicitud
) sub
ORDER BY nom_tipo_servicio, numero_servicio]]></query>
	<field name="nom_completo_admin" class="java.lang.String"/>
	<field name="cargo_admin" class="java.lang.String"/>
	<field name="unidad_admin" class="java.lang.String"/>
	<field name="numero_servicio" class="java.lang.Long"/>
	<field name="nombre_solicitante" class="java.lang.String"/>
	<field name="unidad_sol" class="java.lang.String"/>
	<field name="cod_equipo" class="java.lang.String"/>
	<field name="equipo" class="java.lang.String"/>
