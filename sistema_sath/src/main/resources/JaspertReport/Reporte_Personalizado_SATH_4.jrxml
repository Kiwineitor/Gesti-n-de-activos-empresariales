<!-- Reporte_Personalizado_SATH_4 — JR 7.x format. Filtro: id_tipoequipo. BD legacy. -->
<jasperReport name="Reporte_Personalizado_SATH_4" language="java" pageWidth="792" pageHeight="612" orientation="Landscape" columnWidth="752" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20" uuid="d4e5f6a7-b8c9-0123-def0-234567890123">
	<parameter name="fecha_inicial" class="java.util.Date"/>
	<parameter name="fecha_final"   class="java.util.Date"/>
	<parameter name="id_usuario"    class="java.lang.Long"/>
	<parameter name="id_tipoequipo" class="java.lang.Long"/>
	<parameter name="logoUAP"       class="java.io.InputStream"/>
	<parameter name="logoUSIC"      class="java.io.InputStream"/>
	<query language="sql"><![CDATA[SELECT
    COALESCE(usr_info.nom_completo_u, 'Sistema SATH') AS nom_completo_usuario,
    COALESCE(usr_info.cargo_u, '—')                   AS cargo_usuario,
    s.id_servicio                                      AS numero_servicio,
    concat(p.nombre,' ',p.ap_paterno,' ', p.ap_materno) AS nombre_completo,
    u.unidad, c.cargo, a.cod_equipo, t.equipo, a.descripcion,
    COALESCE(t2.nom_tipo_servicio, 'MANTENIMIENTO CORRECTIVO') AS nom_tipo_servicio,
    s.fecha_recepcion, s.fecha_entrega
FROM servicio s
LEFT JOIN persona p         ON p.id_persona        = s.id_persona
LEFT JOIN tipoequipo t      ON t.id_tipoequipo     = s.id_tipoequipo
LEFT JOIN almacen a         ON a.id_almacen        = s.id_almacen
LEFT JOIN procedencia p2    ON p2.id_procedencia   = s.id_procedencia
LEFT JOIN unidad u          ON u.id_unidad         = p.id_unidad
LEFT JOIN cargo c           ON c.id_cargo          = p.id_cargo
LEFT JOIN grado_academico ga ON ga.id_grado_academico = p.id_grado_academico
LEFT JOIN tiposervicio t2   ON t2.id_tipo_servicio = s.id_tipo_servicio
LEFT JOIN (
    SELECT concat(ga2.sigla_grado_academico,'',pu.nombre,' ', pu.ap_paterno,' ',pu.ap_materno) AS nom_completo_u,
           cu.cargo AS cargo_u
    FROM usuario usr2
    LEFT JOIN persona pu          ON pu.id_persona         = usr2.id_persona
    LEFT JOIN grado_academico ga2 ON ga2.id_grado_academico = pu.id_grado_academico
    LEFT JOIN cargo cu            ON cu.id_cargo            = pu.id_cargo
    WHERE usr2.id_usuario = $P{id_usuario}
      AND (usr2.estado = 'A' OR usr2.estado = 'S')
    LIMIT 1
) AS usr_info ON TRUE
WHERE s.estado_servicio = 'T'
  AND s.id_tipoequipo = $P{id_tipoequipo}
  AND s.fecha_recepcion BETWEEN $P{fecha_inicial} AND $P{fecha_final}
ORDER BY s.fecha_recepcion]]></query>
	<field name="nom_completo_usuario" class="java.lang.String"/>
	<field name="cargo_usuario"        class="java.lang.String"/>
	<field name="numero_servicio"      class="java.lang.Long"/>
	<field name="nombre_completo"      class="java.lang.String"/>
	<field name="unidad"               class="java.lang.String"/>
	<field name="cargo"                class="java.lang.String"/>
	<field name="cod_equipo"           class="java.lang.String"/>
	<field name="equipo"               class="java.lang.String"/>
	<field name="descripcion"          class="java.lang.String"/>
	<field name="nom_tipo_servicio"    class="java.lang.String"/>
	<field name="fecha_recepcion"      class="java.sql.Timestamp"/>
	<field name="fecha_entrega"        class="java.sql.Timestamp"/>
	<variable name="FILA" calculation="Count" class="java.lang.Integer">
		<expression><![CDATA[Integer.valueOf(1)]]></expression>
	</variable>
