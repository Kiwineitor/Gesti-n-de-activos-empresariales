<!-- Created with Jaspersoft Studio version 7.0.3.final using JasperReports Library version 7.0.3-41034ca841d452f3305ba55b9042260aaa1ab5dd  -->
<jasperReport name="Reporte_Servicios_Usuario" language="java" pageWidth="612" pageHeight="792" columnWidth="555" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20" uuid="e5f6a7b8-c9d0-1234-ef01-345678901234">
	<parameter name="id_usuario" class="java.lang.Long"/>
	<parameter name="fecha_inicial" class="java.util.Date"/>
	<parameter name="fecha_final" class="java.util.Date"/>
	<parameter name="logoUAP" class="java.io.InputStream"/>
	<parameter name="logoUSIC" class="java.io.InputStream"/>
	<query language="sql"><![CDATA[SELECT
    COALESCE(usr_info.nom_completo_u, 'Sistema SATH') AS nom_completo_usuario,
    COALESCE(usr_info.cargo_u, '—')                   AS cargo_usuario,
    s.id_servicio,
    COALESCE(t.nom_tipo_servicio, 'MANTENIMIENTO CORRECTIVO') AS nom_tipo_servicio,
    (SELECT u2.unidad FROM unidad u2 LEFT JOIN persona p2 ON p2.id_persona = s.id_persona WHERE u2.id_unidad = p2.id_unidad) AS unidad_funcionario,
    (SELECT upper(concat(p2.nombre,' ',p2.ap_paterno,' ',p2.ap_materno)) FROM persona p2 WHERE p2.id_persona = s.id_persona) AS funcionario,
    t2.equipo AS tipo_equipo,
    a.cod_equipo,
    s.fecha_recepcion,
    s.fecha_entrega
FROM servicio s
LEFT JOIN colaborador c  ON c.id_servicio  = s.id_servicio
LEFT JOIN persona p      ON p.id_persona   = c.id_persona
LEFT JOIN usuario u      ON u.id_persona   = p.id_persona
LEFT JOIN tiposervicio t ON t.id_tipo_servicio = s.id_tipo_servicio
LEFT JOIN tipoequipo t2  ON t2.id_tipoequipo   = s.id_tipoequipo
LEFT JOIN almacen a      ON a.id_almacen        = s.id_almacen
LEFT JOIN (
    SELECT concat(ga.sigla_grado_academico,'',pu.nombre,' ', pu.ap_paterno,' ',pu.ap_materno) AS nom_completo_u,
           cu.cargo AS cargo_u
    FROM usuario usr2
    LEFT JOIN persona pu          ON pu.id_persona         = usr2.id_persona
    LEFT JOIN grado_academico ga  ON ga.id_grado_academico  = pu.id_grado_academico
    LEFT JOIN cargo cu            ON cu.id_cargo             = pu.id_cargo
    WHERE usr2.id_usuario = $P{id_usuario}
      AND (usr2.estado = 'A' OR usr2.estado = 'S')
    LIMIT 1
) AS usr_info ON TRUE
WHERE (c.estado = 'A' OR c.estado = 'B')
    AND s.estado_servicio = 'T'
    AND u.id_usuario = $P{id_usuario}
    AND s.fecha_recepcion BETWEEN $P{fecha_inicial} AND $P{fecha_final}
ORDER BY nom_tipo_servicio, s.fecha_recepcion]]></query>
	<field name="nom_completo_usuario" class="java.lang.String"/>
	<field name="cargo_usuario" class="java.lang.String"/>
	<field name="id_servicio" class="java.lang.Long"/>
